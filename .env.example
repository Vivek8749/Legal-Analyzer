# Copy to .env and fill in what you use. Variables already set in your shell take precedence.

# Default provider: anthropic | openai | gemini | ollama (the web UI can switch per request)
LEGAL_ANALYZER_PROVIDER=anthropic

# --- Frontier models (cloud) -------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# LEGAL_ANALYZER_ANTHROPIC_MODEL=claude-opus-5-5
# LEGAL_ANALYZER_OPENAI_MODEL=gpt-5
# LEGAL_ANALYZER_GEMINI_MODEL=gemini-flash-latest
# Any OpenAI-compatible endpoint (OpenRouter, Groq, DeepSeek, LM Studio, vLLM, …):
# LEGAL_ANALYZER_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LEGAL_ANALYZER_OPENAI_REASONING_EFFORT=medium   # only for reasoning models
# LEGAL_ANALYZER_CONTEXT_WINDOW=128000            # if your OpenAI-compatible model is smaller

# --- Local models (Ollama) ---------------------------------------------------------------
# LEGAL_ANALYZER_OLLAMA_MODEL=qwen3.5:4b
# LEGAL_ANALYZER_OLLAMA_HOST=http://localhost:11434
# LEGAL_ANALYZER_OLLAMA_NUM_CTX=16384      # context window; raise it if you have the VRAM
# LEGAL_ANALYZER_OLLAMA_NUM_PREDICT=4096   # max answer length
# LEGAL_ANALYZER_OLLAMA_THINK=false        # true / low / medium / high for reasoning models
# LEGAL_ANALYZER_OLLAMA_PARALLEL=1         # parallel requests (each needs its own KV cache)

# --- Claude tuning -----------------------------------------------------------------------
# LEGAL_ANALYZER_EFFORT=high
# LEGAL_ANALYZER_SYNTHESIS_EFFORT=medium
# LEGAL_ANALYZER_CHAT_EFFORT=medium
# LEGAL_ANALYZER_FALLBACKS=on

# --- General -----------------------------------------------------------------------------
# LEGAL_ANALYZER_CONCURRENCY=4
# LEGAL_ANALYZER_EMBEDDINGS=fastembed
# LEGAL_ANALYZER_EMBED_MODEL=BAAI/bge-small-en-v1.5
# LEGAL_ANALYZER_DATA_DIR=data
